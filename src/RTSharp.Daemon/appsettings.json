{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ListenAddress": [ "0.0.0.0:1234" ],
  "Certificate": {
    "PublicPem": "/etc/rtsharp-daemon/public.pem",
    "PrivatePem": "/etc/rtsharp-daemon/private.pem"
  },
  "AllowedClients": [
  ],
  "Prometheus": {
    "Enabled": false,
    "Path": "/metrics",
    "PollInterval": "00:01:00"
  },
  "DLBandwidth": 1000000000,
  "UPBandwidth": 1000000000,
  "ScriptStorePath": "/var/lib/rtsharp-daemon/scripts",
  "DatabasePath": "/var/lib/rtsharp-daemon/rtsharp.db",
  "DataProviders": {
    "rtorrent": {
      "my rtorrent": {
        "SCGIListen": "127.0.0.1:5000",
        "SessionDir": "/home/user/.session/",
        "LogFile": "/home/user/.session/rtorrent.log"
      }
    },
    "qbittorrent": {
      "my qbittorrent": {
        "Uri": "http://127.0.0.1:1234/",
        "Username": "admin",
        "Password": "chageme"
      }
    },
    "transmission": {
      "my transmission": {
        "Uri": "http://127.0.0.1:1234/transmission/rpc",
        "Username": "transmission",
        "Password": "changeme",
        "ConfigDir": "/home/user/.config/transmission-daemon/",
        "LogFile": "/home/user/.config/transmission-daemon/transmission.log"
      }
    }
  }
}
