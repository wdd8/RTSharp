<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
		xmlns:converters="clr-namespace:RTSharp.Shared.Controls.Converters;assembly=RTSharp.Shared.Controls"
		xmlns:vm="using:RTSharp.MassTrackerRewrite.Plugin.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		Width="800" Height="450"
		x:Name="window"
        x:Class="RTSharp.MassTrackerRewrite.Plugin.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="avares://RTSharp/Assets/rtsharp.ico"
        WindowStartupLocation="CenterOwner"
        Title="RT# - Mass Tracker Rewrite">
    <Window.Resources>
        <converters:MathConverter x:Key="MathConverter"/>
    </Window.Resources>


	<dialogHost:DialogHost IsOpen="{Binding ProgressDialogShown}">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel Margin="8 8 8 8" Width="{Binding #window.Width, Converter={StaticResource MathConverter}, ConverterParameter=(@VALUE*0.75)}">
                <TextBlock FontWeight="Bold" Text="Loading..." />
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>
		<Grid ColumnDefinitions="4*, Auto, 8*" RowDefinitions="*" Margin="{DynamicResource DialogMargin}">
			<GroupBox Grid.Column="0" Header="Trackers">
				<ListBox
					SelectionMode="Single"
					ItemsSource="{Binding Trackers}"
					SelectedItem="{Binding SelectedTracker, Mode=TwoWay}"
					ScrollViewer.VerticalScrollBarVisibility="Auto"
					IsEnabled="{Binding !IsBusy}" />
			</GroupBox>
			<GridSplitter Grid.Column="1" Width="{DynamicResource GroupSpacing}" Background="Transparent" ResizeDirection="Columns" />
			<StackPanel Grid.Column="2"
				Spacing="{DynamicResource ControlSpacing}"
				IsEnabled="{Binding !IsBusy}">
					<Label Target="{Binding #CurrentBox}">_Selected tracker:</Label>
					<TextBox Name="CurrentBox" Text="{Binding SelectedTracker.Uri}" IsReadOnly="True" />
					<Label Target="{Binding #ReplacementBox}">Replace _with:</Label>
					<TextBox Name="ReplacementBox" Text="{Binding UrlText, Mode=TwoWay}" />
					<TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
					<ProgressBar Minimum="0" Maximum="100" Height="16" Value="{Binding ProgressValue}" />
					<StackPanel Classes="DialogButtons">
						<Button IsDefault="True" Command="{Binding GoCommand}">_Replace</Button>
					</StackPanel>
			</StackPanel>
		</Grid>
	</dialogHost:DialogHost>
</Window>