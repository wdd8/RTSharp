<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RTSharp.ServerScriptPlayground.Plugin.ViewModels"
        xmlns:views="using:RTSharp.ServerScriptPlayground.Plugin.Views"
        xmlns:abstractions="using:RTSharp.Shared.Abstractions"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RTSharp.ServerScriptPlayground.Plugin.Views.PlaygroundWindow"
        x:DataType="vm:PlaygroundWindowViewModel"
        Title="RT# - Script playground">

    <Window.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
        <ComboBox Grid.Row="0" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" HorizontalAlignment="Stretch" />
        <AvaloniaEdit:TextEditor Name="Editor" Grid.Row="1"
                               ShowLineNumbers="True"
                               FontFamily="Cascadia Code,Consolas,Menlo,Monospace">
            <Interaction.Behaviors>
                <views:DocumentTextBindingBehavior Text="{Binding Script, Mode=TwoWay}"/>
            </Interaction.Behaviors>
        </AvaloniaEdit:TextEditor>
        <Separator Grid.Row="2" />

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
            <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="{Binding RunButtonText}" Command="{Binding RunButtonCommand}" />
            <TextBox Grid.Column="1" Width="180" Margin="4,0" Watermark="Service id"
                     Text="{Binding ServiceId}" />
            <Button Grid.Column="2" Content="Install as service" Command="{Binding InstallServiceCommand}" />
            <Button Grid.Column="3" Content="Refresh" Margin="4,0,0,0" Command="{Binding RefreshInstalledCommand}" />
        </Grid>

        <Border Grid.Row="4" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="4">
            <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Text="Installed services" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1" MaxHeight="140">
                    <ItemsControl ItemsSource="{Binding InstalledScripts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="abstractions:InstalledScript">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Text="{Binding Name}" ToolTip.Tip="{Binding LastError}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                               Text="{Binding State}" ToolTip.Tip="{Binding StatusText}" />
                                    <Button Grid.Column="2" Content="Uninstall"
                                            Command="{Binding $parent[ItemsControl].((vm:PlaygroundWindowViewModel)DataContext).UninstallServiceCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
