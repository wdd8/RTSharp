<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RTSharp.ServerScriptPlayground.Plugin.ViewModels"
        xmlns:views="using:RTSharp.ServerScriptPlayground.Plugin.Views"
        xmlns:abstractions="using:RTSharp.Shared.Abstractions"
        xmlns:sc="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RTSharp.ServerScriptPlayground.Plugin.Views.PlaygroundWindow"
        x:DataType="vm:PlaygroundWindowViewModel"
        WindowStartupLocation="CenterOwner"
        Title="RT# - Script Playground">

    <Window.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{DynamicResource ControlSpacing}" Margin="{DynamicResource DialogMargin}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource ControlSpacing}">
            <Label Grid.Column="0" Target="{Binding #ServerBox}">_Server:</Label>
            <ComboBox Grid.Column="1" Name="ServerBox" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" HorizontalAlignment="Stretch" />
        </Grid>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <AvaloniaEdit:TextEditor Name="Editor"
                                   ShowLineNumbers="True"
                                   FontFamily="Cascadia Code,Consolas,Menlo,Monospace">
                <Interaction.Behaviors>
                    <views:DocumentTextBindingBehavior Text="{Binding Script, Mode=TwoWay}"/>
                </Interaction.Behaviors>
            </AvaloniaEdit:TextEditor>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource ControlSpacing}">
            <Button Grid.Column="0" HorizontalAlignment="Left" MinWidth="75" HorizontalContentAlignment="Center"
                    Content="{Binding RunButtonText}" Command="{Binding RunButtonCommand}" />
            <Label Grid.Column="1" Target="{Binding #ServiceIdBox}">Service _ID:</Label>
            <TextBox Grid.Column="2" Name="ServiceIdBox" Width="180" Text="{Binding ServiceId}" />
            <Button Grid.Column="3" Content="Install as Ser_vice" Command="{Binding InstallServiceCommand}" />
        </Grid>

        <GroupBox Grid.Row="3" Header="Installed Services">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource ControlSpacing}">
                <Button Grid.Row="0" HorizontalAlignment="Right" MinWidth="75" HorizontalContentAlignment="Center" Command="{Binding RefreshInstalledCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <sc:BuiltInIconImage Value="REFRESH" Width="16" Height="16" />
                        <AccessText Text="_Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ScrollViewer Grid.Row="1" MaxHeight="140">
                    <ItemsControl ItemsSource="{Binding InstalledScripts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="abstractions:InstalledScript">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Text="{Binding Name}" ToolTip.Tip="{Binding LastError}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                               Text="{Binding State}" ToolTip.Tip="{Binding StatusText}" />
                                    <Button Grid.Column="2" Content="Unorphan" Margin="0,0,7,0"
                                            IsVisible="{Binding OrphanAcknowledged}"
                                            Command="{Binding $parent[ItemsControl].((vm:PlaygroundWindowViewModel)DataContext).UnorphanServiceCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Content="Uninstall"
                                            Command="{Binding $parent[ItemsControl].((vm:PlaygroundWindowViewModel)DataContext).UninstallServiceCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
