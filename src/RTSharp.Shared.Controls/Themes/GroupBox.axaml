<Styles xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="GroupBox /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="CheckBox.GroupBoxHeader /template/ Grid#RootGrid > Grid">
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="CheckBox.GroupBoxHeader /template/ Border#NormalRectangle">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="CheckBox.GroupBoxHeader /template/ Viewbox">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="CheckBox.GroupBoxHeader /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="-2,0,0,0" />
    </Style>

    <Style Selector="RadioButton.GroupBoxHeader /template/ Border#RootBorder > Grid > Grid">
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="RadioButton.GroupBoxHeader /template/ Ellipse#OuterEllipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="RadioButton.GroupBoxHeader /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="RadioButton.GroupBoxHeader /template/ Ellipse#CheckGlyph">
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="RadioButton.GroupBoxHeader /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="-6,0,0,0" />
    </Style>

</Styles>
