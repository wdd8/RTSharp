<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>1.0.0.0</Version>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <Features>runtime-async=on</Features>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BencodeNET" Version="5.0.0" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Google.Protobuf" Version="3.36.2" />
      <PackageReference Include="MessagePack" Version="3.1.12" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
      <PackageReference Include="System.Reactive" Version="7.0.0" />
    </ItemGroup>
</Project>
