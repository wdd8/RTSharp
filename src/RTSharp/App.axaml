<Application x:Class="RTSharp.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:np="https://np.com/visuals"
             xmlns:local="clr-namespace:RTSharp"
             xmlns:converters="using:RTSharp.Views.Converters"
             xmlns:vm="clr-namespace:RTSharp.ViewModels"
             xmlns:dock="clr-namespace:Dock.Model.Core;assembly=Dock.Model"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:av="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:sc="using:RTSharp.Shared.Controls.Views"
             x:DataType="vm:AppViewModel">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <converters:IconConverter x:Key="IconConverter"/>
    </Application.Resources>

    <Application.Styles>
        <dialogHostAvalonia:DialogHostStyles />
        <StyleInclude Source="avares://MsBox.Avalonia.Markdown/Controls/MarkdownView.axaml" />

        <Style Selector="DocumentControl">
          <Setter Property="IconTemplate">
            <DataTemplate x:DataType="dock:IDockable">
                <sc:BuiltInPathIcon
                    Value="{Binding ., Converter={StaticResource IconConverter}}"
                    Width="16"
                    Height="16"
                    Margin="0" />
            </DataTemplate>
          </Setter>
        </Style>

        <Style Selector="DataGridRow.odd">
            <Setter Property="Background" Value="{DynamicResource DataGridAlternatingRowBrush}" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/rtsharp.ico" ToolTipText="{Binding TrayIconText}" IsVisible="{Binding TrayIconVisible}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Exit" Click="Exit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
    
</Application>
