<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:converters="clr-namespace:RTSharp.Shared.Controls.Converters;assembly=RTSharp.Shared.Controls"
        xmlns:vm="using:RTSharp.ViewModels.Tools"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="410"
        Name="window"
        Width="440" Height="410"
        CanResize="False"
        x:Class="RTSharp.Views.Tools.TorrentCreatorWindow"
		x:DataType="vm:TorrentCreatorWindowViewModel"
        Title="RT# - Torrent Creator"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True">

    <Design.DataContext>
        <vm:TorrentCreatorWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:MathConverter x:Key="MathConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TabItem Grid.Fields">
            <Setter Property="ColumnSpacing" Value="{StaticResource ControlSpacing}" />
            <Setter Property="RowSpacing" Value="{StaticResource ControlSpacing}" />
        </Style>
        <Style Selector="TabItem Grid.Fields > Label.Top">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0 4 0 0" />
        </Style>
    </Window.Styles>

    <dialogHost:DialogHost Name="ProgressDialog" DisableOpeningAnimation="True" IsOpen="{Binding ProgressInfoInstance.Shown}">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel Margin="8 8 8 8" Width="{Binding #window.Width, Converter={StaticResource MathConverter}, ConverterParameter=(@VALUE*0.75)}">
                <StackPanel.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0 0 8 4"/>
                    </Style>
                    <Style Selector="ProgressBar">
                        <Setter Property="Height" Value="15"/>
                    </Style>
                </StackPanel.Styles>

                <TextBlock FontWeight="Bold" Text="{Binding ProgressInfoInstance.CurrentFile}" TextTrimming="WordEllipsis" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*">
                    <TextBlock Grid.Column="0" Grid.Row="0">File:</TextBlock>
                    <ProgressBar Grid.Column="1" Grid.Row="0" Value="{Binding ProgressInfoInstance.FileProgress}" ShowProgressText="True" Minimum="0" Maximum="100" />

                    <TextBlock Grid.Column="0" Grid.Row="1">Buffer:</TextBlock>
                    <ProgressBar Grid.Column="1" Grid.Row="1" Value="{Binding ProgressInfoInstance.FileBuffer}" ShowProgressText="True" Minimum="0" Maximum="100" />

                    <TextBlock Grid.Column="0" Grid.Row="2">Hash:</TextBlock>
                    <ProgressBar Grid.Column="1" Grid.Row="2" Value="{Binding ProgressInfoInstance.HashProgress}" ShowProgressText="True" Minimum="0" Maximum="100" />
                </Grid>
                <TextBlock Text="{Binding ProgressInfoInstance.HashExcerpt}" />
                <Button HorizontalAlignment="Center" Command="{Binding CancelHashingClick}">Cancel</Button>
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>

        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Classes="DialogButtons" Margin="{StaticResource DialogMargin}">
                <Button IsDefault="True" Command="{Binding CreateTorrentClickCommand}">Create Torrent</Button>
                <Button IsCancel="True" Command="{Binding CancelClickCommand}">Cancel</Button>
            </StackPanel>

            <TabControl Margin="11,11,11,0">
                <TabItem Header="Source">
                    <DockPanel Margin="{StaticResource DialogMargin}">
                        <Label DockPanel.Dock="Top" Margin="0 0 0 4" Target="{Binding #SourcePathBox}">_File or folder:</Label>
                        <TextBox DockPanel.Dock="Top" Name="SourcePathBox" Text="{Binding SourcePath}" />
                        <StackPanel DockPanel.Dock="Bottom" Classes="DialogButtons">
                            <Button Command="{Binding SelectFileClick}">Select F_ile...</Button>
                            <Button Command="{Binding SelectFolderClick}">Select Fo_lder...</Button>
                        </StackPanel>
                        <Border Name="DragDropPanel"
                                DragDrop.AllowDrop="True"
                                Background="Transparent"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                Margin="0 11 0 11">
                            <TextBlock
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="Gray"
                                Text="Drop a file or folder here" />
                        </Border>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Settings">
                    <Grid Classes="Fields" ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="{StaticResource DialogMargin}">
                        <Label Grid.Column="0" Grid.Row="0" Target="{Binding #CmbPieceLength}">_Piece size:</Label>
                        <ComboBox Grid.Column="1" Grid.Row="0" Name="CmbPieceLength" Width="125" SelectedIndex="0" SelectedItem="{Binding StrPieceLength}">
                            <ComboBoxItem>Auto</ComboBoxItem>
                            <ComboBoxItem>16 KiB</ComboBoxItem>
                            <ComboBoxItem>32 KiB</ComboBoxItem>
                            <ComboBoxItem>64 KiB</ComboBoxItem>
                            <ComboBoxItem>128 KiB</ComboBoxItem>
                            <ComboBoxItem>256 KiB</ComboBoxItem>
                            <ComboBoxItem>512 KiB</ComboBoxItem>
                            <ComboBoxItem>1 MiB</ComboBoxItem>
                            <ComboBoxItem>2 MiB</ComboBoxItem>
                            <ComboBoxItem>4 MiB</ComboBoxItem>
                            <ComboBoxItem>8 MiB</ComboBoxItem>
                            <ComboBoxItem>16 MiB</ComboBoxItem>
                            <ComboBoxItem>32 MiB</ComboBoxItem>
                        </ComboBox>

                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                            <Button Command="{Binding CalculateNumberOfPiecesClickCommand}">_Calculate Number of Pieces</Button>
                            <TextBlock VerticalAlignment="Center" Text="{Binding NumberOfPieces}" />
                        </StackPanel>

                        <Label Grid.Column="0" Grid.Row="2" Target="{Binding #CmbVersion}">Ve_rsion:</Label>
                        <ComboBox Grid.Column="1" Grid.Row="2" Name="CmbVersion" Width="125" SelectedIndex="0" SelectedItem="{Binding StrVersion}">
                            <ComboBoxItem>V1</ComboBoxItem>
                            <ComboBoxItem>V2</ComboBoxItem>
                            <ComboBoxItem>Hybrid</ComboBoxItem>
                        </ComboBox>

                        <CheckBox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" Margin="0 4 0 0" IsChecked="{Binding PrivateTorrent}">Pri_vate torrent (won't distribute on DHT network)</CheckBox>
                        <CheckBox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="4" IsChecked="{Binding Entropy}">Add _entropy (makes torrent unique)</CheckBox>
                        <CheckBox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5" IsChecked="{Binding EmitCreationDate}">Emit creation _date</CheckBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Fields">
                    <Grid Classes="Fields" ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,Auto" Margin="{StaticResource DialogMargin}">
                        <Label Grid.Column="0" Grid.Row="0" Classes="Top" Target="{Binding #TrackerUrlsBox}">_Tracker URLs:</Label>
                        <TextBox Grid.Column="1" Grid.Row="0" Name="TrackerUrlsBox" AcceptsReturn="True" Text="{Binding TrackerUrls}" />

                        <Label Grid.Column="0" Grid.Row="1" Classes="Top" Target="{Binding #WebSeedUrlsBox}">_Web seed URLs:</Label>
                        <TextBox Grid.Column="1" Grid.Row="1" Name="WebSeedUrlsBox" AcceptsReturn="True" Text="{Binding WebSeedUrls}" />

                        <Label Grid.Column="0" Grid.Row="2" Classes="Top" Target="{Binding #CommentsBox}">Co_mments:</Label>
                        <TextBox Grid.Column="1" Grid.Row="2" Name="CommentsBox" AcceptsReturn="True" Text="{Binding Comments}" />

                        <Label Grid.Column="0" Grid.Row="3" Target="{Binding #SourceBox}">So_urce:</Label>
                        <TextBox Grid.Column="1" Grid.Row="3" Name="SourceBox" Text="{Binding Source}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </dialogHost:DialogHost>
</Window>
