<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:views="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
        xmlns:converters="clr-namespace:RTSharp.Shared.Controls.Converters;assembly=RTSharp.Shared.Controls"
        xmlns:vm="using:RTSharp.ViewModels.Tools"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="592" d:DesignHeight="750"
        Name="window"
        MinWidth="592"
        x:Class="RTSharp.Views.Tools.TorrentCreatorWindow"
		x:DataType="vm:TorrentCreatorWindowViewModel"
        Title="RT# - Torrent Creator"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True">

    <Design.DataContext>
        <vm:TorrentCreatorWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:MathConverter x:Key="MathConverter"/>
    </Window.Resources>

    <dialogHost:DialogHost Name="ProgressDialog" DisableOpeningAnimation="True" IsOpen="{Binding ProgressInfoInstance.Shown}">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel Margin="8 8 8 8" Width="{Binding #window.Width, Converter={StaticResource MathConverter}, ConverterParameter=(@VALUE*0.75)}">
                <StackPanel.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0 0 8 4"/>
                    </Style>
                    <Style Selector="ProgressBar">
                        <Setter Property="Height" Value="15"/>
                    </Style>
                </StackPanel.Styles>
                
                <TextBlock FontWeight="Bold" Text="{Binding ProgressInfoInstance.CurrentFile}" TextTrimming="WordEllipsis" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*">
                    <TextBlock Grid.Column="0" Grid.Row="0">File:</TextBlock>
                    <ProgressBar Grid.Column="1" Grid.Row="0" Value="{Binding ProgressInfoInstance.FileProgress}" ShowProgressText="True" Minimum="0" Maximum="100" />

                    <TextBlock Grid.Column="0" Grid.Row="1">Buffer:</TextBlock>
                    <ProgressBar Grid.Column="1" Grid.Row="1" Value="{Binding ProgressInfoInstance.FileBuffer}" ShowProgressText="True" Minimum="0" Maximum="100" />

                    <TextBlock Grid.Column="0" Grid.Row="2">Hash:</TextBlock>
                    <ProgressBar Grid.Column="1" Grid.Row="2" Value="{Binding ProgressInfoInstance.HashProgress}" ShowProgressText="True" Minimum="0" Maximum="100" />
                </Grid>
                <TextBlock Text="{Binding ProgressInfoInstance.HashExcerpt}" />
                <Button HorizontalAlignment="Center" Command="{Binding CancelHashingClick}">Cancel</Button>
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>
        <StackPanel Margin="{StaticResource DialogMargin}">
            <GroupBox Header="Select file/folder">
                <StackPanel Spacing="{StaticResource ControlSpacing}">
                    <TextBox Text="{Binding SourcePath}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource ControlSpacing}">
                        <Panel Grid.Column="0" DragDrop.AllowDrop="True" Name="DragDropPanel">
                            <TextBlock
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="Gray"
                                Text="[Drag and drop area]" />
                        </Panel>
                        <Button Grid.Column="1" Command="{Binding SelectFileClick}">Select _File...</Button>
                        <Button Grid.Column="2" Command="{Binding SelectFolderClick}">Select Fo_lder...</Button>
                    </Grid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Settings">
                <StackPanel Orientation="Vertical" Spacing="{StaticResource ControlSpacing}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                        <Label Target="{Binding #CmbPieceLength}">_Piece size:</Label>
                        <ComboBox Name="CmbPieceLength" VerticalAlignment="Center" Width="125" SelectedIndex="0" SelectedItem="{Binding StrPieceLength}">
                            <ComboBoxItem>Auto</ComboBoxItem>
                            <ComboBoxItem>16 KiB</ComboBoxItem>
                            <ComboBoxItem>32 KiB</ComboBoxItem>
                            <ComboBoxItem>64 KiB</ComboBoxItem>
                            <ComboBoxItem>128 KiB</ComboBoxItem>
                            <ComboBoxItem>256 KiB</ComboBoxItem>
                            <ComboBoxItem>512 KiB</ComboBoxItem>
                            <ComboBoxItem>1 MiB</ComboBoxItem>
                            <ComboBoxItem>2 MiB</ComboBoxItem>
                            <ComboBoxItem>4 MiB</ComboBoxItem>
                            <ComboBoxItem>8 MiB</ComboBoxItem>
                            <ComboBoxItem>16 MiB</ComboBoxItem>
                            <ComboBoxItem>32 MiB</ComboBoxItem>
                        </ComboBox>
                        <Button Command="{Binding CalculateNumberOfPiecesClickCommand}">_Calculate Number of Pieces:</Button>
                        <TextBlock VerticalAlignment="Center" Text="{Binding NumberOfPieces}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding PrivateTorrent}">Pri_vate torrent (won't distribute on DHT network)</CheckBox>
                    <CheckBox IsChecked="{Binding Entropy}">Add _entropy (makes torrent unique)</CheckBox>
                    <CheckBox IsChecked="{Binding EmitCreationDate}">Emit creation _date</CheckBox>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                        <Label Target="{Binding #CmbVersion}">Ve_rsion:</Label>
                        <ComboBox Name="CmbVersion" VerticalAlignment="Center" Width="125" SelectedIndex="0" SelectedItem="{Binding StrVersion}">
                            <ComboBoxItem>V1</ComboBoxItem>
                            <ComboBoxItem>V2</ComboBoxItem>
                            <ComboBoxItem>Hybrid</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <!--<GroupBox IsEnabled="False">
                        <GroupBox.Header>
                            <CheckBox Classes="GroupBoxHeader" IsChecked="{Binding OptimiseAlignment}">Optimise alignment</CheckBox>
                        </GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Margin="4" IsEnabled="{Binding OptimiseAlignment}">
                            <TextBlock VerticalAlignment="Center">Align to piece boundary for files larger than:</TextBlock>
                            <NumericUpDown Margin="4 0 0 0" Value="0" Increment="1" />
                        </StackPanel>
                    </GroupBox>-->
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Fields">
                <!-- Labels sit at the top of the tall text boxes, beside their first line -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*,*,*" ColumnSpacing="{StaticResource ControlSpacing}" RowSpacing="{StaticResource ControlSpacing}">
                    <Grid.Styles>
                        <Style Selector="Label">
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Margin" Value="0 4 0 0" />
                        </Style>
                    </Grid.Styles>
                    <Label Grid.Column="0" Grid.Row="0" Target="{Binding #TrackerUrlsBox}">_Tracker URLs:</Label>
                    <TextBox Grid.Column="1" Grid.Row="0" Name="TrackerUrlsBox" AcceptsReturn="True" Height="125" Text="{Binding TrackerUrls}" />

                    <Label Grid.Column="0" Grid.Row="1" Target="{Binding #WebSeedUrlsBox}">_Web seed URLs:</Label>
                    <TextBox Grid.Column="1" Grid.Row="1" Name="WebSeedUrlsBox" AcceptsReturn="True" Height="125" Text="{Binding WebSeedUrls}" />

                    <Label Grid.Column="0" Grid.Row="2" Target="{Binding #CommentsBox}">Co_mments:</Label>
                    <TextBox Grid.Column="1" Grid.Row="2" Name="CommentsBox" AcceptsReturn="True" Height="125" Text="{Binding Comments}" />

                    <Label Grid.Column="0" Grid.Row="3" Target="{Binding #SourceBox}">So_urce:</Label>
                    <TextBox Grid.Column="1" Grid.Row="3" Name="SourceBox" Text="{Binding Source}" />
                </Grid>
            </GroupBox>
            <StackPanel Classes="DialogButtons" Margin="0 11 0 0">
                <Button IsDefault="True" Command="{Binding CreateTorrentClickCommand}">Create Torrent</Button>
                <Button IsCancel="True" Command="{Binding CancelClickCommand}">Cancel</Button>
            </StackPanel>
        </StackPanel>
    </dialogHost:DialogHost>
</Window>
