<UserControl x:Class="RTSharp.Views.TorrentListing.TorrentPeersView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RTSharp.ViewModels.Converters;assembly=RTSharp"
             xmlns:models="clr-namespace:RTSharp.Models"
             xmlns:torrentListing="clr-namespace:RTSharp.ViewModels.TorrentListing"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:sc="using:RTSharp.Shared.Controls.Views"
             xmlns:dataGridEx="using:RTSharp.Views.DataGridEx"
             d:DesignWidth="1100" d:DesignHeight="450"
			 x:DataType="torrentListing:TorrentPeersViewModel">

    <Control.Resources>
        <converters:SIDataSizeConverter x:Key="SIDataSizeConverter"/>
        <converters:SIDataSpeedConverter x:Key="SIDataSpeedConverter"/>
    </Control.Resources>
    <Design.DataContext>
        <torrentListing:TorrentPeersViewModel />
    </Design.DataContext>

    <dialogHost:DialogHost Name="DialogHostAddPeer" Identifier="AddPeerHost" CloseOnClickAway="True" MaxWidth="1.7976931348623157E+308" MaxHeight="1.7976931348623157E+308">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel>
                <TextBlock FontWeight="Bold">Add peer</TextBlock>
                <TextBox Name="AddPeerEndpoint" PlaceholderText="IP:Port" Text="{Binding AddPeerEndpointText}" />
                <Button
                    Margin="0 -6 0 -7"
                    Width="0"
                    IsDefault="True"
                    Command="{Binding AddPeersCommand}"
                />
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>

    <DataGrid Name="MainGrid"
                  ItemsSource="{Binding PeersView}"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  OwnsSortDescriptions="True"
                  SortCycleMode="AscendingDescendingNone"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  VerticalAlignment="Stretch">
        <DataGrid.ContextMenu>
            <ContextMenu x:DataType="torrentListing:TorrentPeersViewModel">
                <MenuItem Header="Add peer..."
                          Command="{Binding #DialogHostAddPeer.OpenDialogCommand}"
                    />
                <Separator />
                <MenuItem Header="Ban peer"
                          Command="{Binding BanPeerCommand}"
                          CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
            </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
            <DataGridTemplateColumn Header="Icon" ColumnKey="Icon" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:Peer">
                        <Panel>
                            <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" />
                            <sc:BuiltInPathIcon Value="WEB" Width="16" Height="16" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                        </Panel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Origin" ColumnKey="Origin" x:DataType="models:Peer" Binding="{Binding Origin, Mode=OneWay}" SortMemberPath="Origin" />

            <DataGridTextColumn Header="IP:Port" ColumnKey="IPPort" x:DataType="models:Peer" Binding="{Binding IPPortDisplay, Mode=OneWay}" SortMemberPath="IPPortDisplay" />
            <DataGridTextColumn Header="Client" ColumnKey="Client" x:DataType="models:Peer" Binding="{Binding Client, Mode=OneWay}" SortMemberPath="Client" />
            <DataGridTextColumn Header="Flags" ColumnKey="Flags" x:DataType="models:Peer" Binding="{Binding Flags, Mode=OneWay}" SortMemberPath="Flags" />
            <DataGridTemplateColumn Header="Done" ColumnKey="Done" SortMemberPath="Done">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="models:Peer">
                        <dataGridEx:ProgressCell Value="{Binding Done, Mode=OneWay}" MinWidth="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            FontSize="{DynamicResource ControlContentThemeFontSize}"
                            FillBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                            TrackBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="DL Speed" ColumnKey="DLSpeed" x:DataType="models:Peer" Binding="{Binding DLSpeed, Mode=OneWay, Converter={StaticResource SIDataSpeedConverter}}" SortMemberPath="DLSpeed" />
            <DataGridTextColumn Header="UP Speed" ColumnKey="UPSpeed" x:DataType="models:Peer" Binding="{Binding UPSpeed, Mode=OneWay, Converter={StaticResource SIDataSpeedConverter}}" SortMemberPath="UPSpeed" />
            <DataGridTextColumn Header="Downloaded" ColumnKey="Downloaded" x:DataType="models:Peer" Binding="{Binding Downloaded, Mode=OneWay, Converter={StaticResource SIDataSizeConverter}}" SortMemberPath="Downloaded" />
            <DataGridTextColumn Header="Uploaded" ColumnKey="Uploaded" x:DataType="models:Peer" Binding="{Binding Uploaded, Mode=OneWay, Converter={StaticResource SIDataSizeConverter}}" SortMemberPath="Uploaded" />
            <DataGridTextColumn Header="Peer DL Speed" ColumnKey="PeerDLSpeed" x:DataType="models:Peer" Binding="{Binding PeerDLSpeed, Mode=OneWay, Converter={StaticResource SIDataSpeedConverter}}" SortMemberPath="PeerDLSpeed" />
        </DataGrid.Columns>
    </DataGrid>
    </dialogHost:DialogHost>
</UserControl>
