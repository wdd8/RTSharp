<UserControl x:Class="RTSharp.Views.TorrentListing.TorrentTrackersView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:RTSharp.ViewModels.Converters;assembly=RTSharp"
             xmlns:models="clr-namespace:RTSharp.Models"
             xmlns:torrentListing="clr-namespace:RTSharp.ViewModels.TorrentListing"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:s="clr-namespace:System;assembly=System.Runtime"
             xmlns:sc="using:RTSharp.Shared.Controls.Views"
             d:DesignWidth="1100" d:DesignHeight="450"
             x:DataType="torrentListing:TorrentTrackersViewModel">

    <Control.Resources>
        <converters:ETATimeSpanConverter x:Key="ETATimeSpanConverter"/>
        <converters:ItemsParamConverter x:Key="ItemsParamConverter"/>
    </Control.Resources>
    <Design.DataContext>
        <torrentListing:TorrentTrackersViewModel />
    </Design.DataContext>

    <dialogHost:DialogHost Name="DialogHost" Identifier="SetNameHost" CloseOnClickAway="True" MaxWidth="1.7976931348623157E+308" MaxHeight="1.7976931348623157E+308">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <TextBlock FontWeight="Bold">Set Name for</TextBlock>
                    <TextBlock FontWeight="Bold" Margin="4 0 0 0" Text="{Binding #MainGrid.((models:Tracker)SelectedItem).Domain}" />
                </StackPanel>
                <TextBox Name="TrackerName" Text="{Binding #MainGrid.((models:Tracker)SelectedItem).DisplayName, Mode=OneTime}" />
                <Button
                    Margin="0 -6 0 -7"
                    Width="0"
                    IsDefault="True"
                    Command="{Binding SetNameCommand}"
                >
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource ItemsParamConverter}">
                            <Binding Path="#MainGrid.SelectedItems" />
                            <Binding Path="#TrackerName.Text" />
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>
	<dialogHost:DialogHost Name="DialogHostReplace" Identifier="ReplaceTrackerHost" CloseOnClickAway="True" MaxWidth="1.7976931348623157E+308" MaxHeight="1.7976931348623157E+308">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel>
                <TextBlock FontWeight="Bold">Replace Tracker With</TextBlock>
                <TextBox Name="NewTracker" Text="{Binding #MainGrid.((models:Tracker)SelectedItem).Uri, Mode=OneTime}" />
                <Button
                    Margin="0 -6 0 -7"
                    Width="0"
                    IsDefault="True"
                    Command="{Binding ReplaceTrackerCommand}"
                >
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource ItemsParamConverter}">
                            <Binding Path="#MainGrid.SelectedItems" />
                            <Binding Path="#NewTracker.Text" />
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>
	<dialogHost:DialogHost Name="DialogHostAddNew" Identifier="AddNewTrackerHost" CloseOnClickAway="True" MaxWidth="1.7976931348623157E+308" MaxHeight="1.7976931348623157E+308">
        <dialogHost:DialogHost.DialogContent>
            <StackPanel>
                <TextBlock FontWeight="Bold">Add a New Tracker</TextBlock>
                <TextBox Name="AddNewTrackerText" />
                <Button
                    Margin="0 -6 0 -7"
                    Width="0"
                    IsDefault="True"
                    Command="{Binding AddNewTrackerCommand}"
                    CommandParameter="{Binding #AddNewTrackerText.Text}"
                />
            </StackPanel>
        </dialogHost:DialogHost.DialogContent>

        <DataGrid Name="MainGrid"
                      ItemsSource="{Binding TrackersView}"
                      SelectedItem="{Binding SelectedItem}"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      OwnsSortDescriptions="True"
                      SortCycleMode="AscendingDescendingNone"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      SelectionMode="Extended">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Add a New Tracker..."
                              Command="{Binding #DialogHostAddNew.OpenDialogCommand}"
                    />
                    <Separator />
                    <MenuItem Header="_Enable"
                              Command="{Binding EnableCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                    <MenuItem Header="_Disable"
                              Command="{Binding DisableCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                    <MenuItem Header="_Remove"
                              Command="{Binding RemoveCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                    <MenuItem Header="Re_place..."
                              Command="{Binding #DialogHostReplace.OpenDialogCommand}"
                              IsEnabled="{Binding HasSelectedItem}"
                    />
                    <Separator />
                    <MenuItem Header="Rea_nnounce"
                              Command="{Binding ReannounceCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                    <Separator />
                    <MenuItem Header="Set _Name..."
                              Command="{Binding #DialogHost.OpenDialogCommand}"
                              IsEnabled="{Binding HasSelectedItem}"
                    />
                    <MenuItem Header="Set _Icon..."
                              Command="{Binding SetIconCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                    <MenuItem Header="_Fetch Icon"
                              Command="{Binding FetchIconCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Icon" ColumnKey="Icon" CanUserSort="False" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Tracker">
                            <Panel>
                                <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" />
                                <sc:BuiltInPathIcon Value="WEB" Width="16" Height="16" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" ColumnKey="Display" SortMemberPath="Display" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Tracker">
                            <Border ToolTip.Tip="{Binding Uri, Mode=OneWay}">
                                <TextBlock Text="{Binding Display, Mode=OneWay}" Margin="{DynamicResource DataGridCellTextBlockMargin}" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" ColumnKey="Status" x:DataType="models:Tracker" Binding="{Binding Status, Mode=OneWay}" SortMemberPath="Status" Width="170" />
                <DataGridTextColumn Header="Seeders" ColumnKey="Seeders" x:DataType="models:Tracker" Binding="{Binding Seeders, Mode=OneWay}" SortMemberPath="Seeders" Width="90" />
                <DataGridTextColumn Header="Peers" ColumnKey="Peers" x:DataType="models:Tracker" Binding="{Binding Peers, Mode=OneWay}" SortMemberPath="Peers" Width="80" />
                <DataGridTextColumn Header="Downloaded" ColumnKey="Downloaded" x:DataType="models:Tracker" Binding="{Binding Downloaded, Mode=OneWay}" SortMemberPath="Downloaded" Width="120" />
                <DataGridTextColumn Header="Last updated" ColumnKey="LastUpdatedDate" x:DataType="models:Tracker" Binding="{Binding LastUpdatedDate, Mode=OneWay}" SortMemberPath="LastUpdatedDate" Width="170" />
                <DataGridTextColumn Header="Interval" ColumnKey="Interval" x:DataType="models:Tracker" Binding="{Binding Interval, Mode=OneWay, Converter={StaticResource ETATimeSpanConverter}}" SortMemberPath="Interval" Width="100" />
                <DataGridTextColumn Header="Next announce" ColumnKey="NextAnnounceDate" x:DataType="models:Tracker" Binding="{Binding NextAnnounceDate, Mode=OneWay}" SortMemberPath="NextAnnounceDate" Width="170" />
                <DataGridTextColumn Header="Message" ColumnKey="Message" x:DataType="models:Tracker" Binding="{Binding Message, Mode=OneWay}" SortMemberPath="Message" Width="300" />
            </DataGrid.Columns>
        </DataGrid>
    </dialogHost:DialogHost>
    </dialogHost:DialogHost>
    </dialogHost:DialogHost>
</UserControl>
