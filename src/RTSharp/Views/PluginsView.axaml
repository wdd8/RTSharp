<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RTSharp.ViewModels"
        xmlns:plugin="clr-namespace:RTSharp.Plugin"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
        x:DataType="vm:PluginsViewModel"
        x:CompileBindings="True"
        Width="640" Height="360"
        MinWidth="420" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True"
        x:Class="RTSharp.Views.PluginsView"
        Icon="/Assets/rtsharp.ico"
        Title="RT# - Plugins">

    <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource GroupSpacing}" Margin="{StaticResource DialogMargin}">
        <DataGrid Grid.Row="0"
                  Name="PluginsGrid"
                  ItemsSource="{Binding Plugins}"
                  SelectedItem="{Binding CurrentlySelectedPlugin}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  DoubleTapped="EvDoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <!-- Bold: also carried out by double-clicking a plugin -->
                    <MenuItem Header="_Settings" FontWeight="Bold" Command="{Binding PluginsSettingsClickCommand}" />
                    <Separator />
                    <MenuItem Header="Copy _Instance GUID" Click="EvCopyInstanceGuid" />
                    <MenuItem Header="Copy _Plugin GUID" Click="EvCopyPluginGuid" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" x:DataType="plugin:RTSharpPlugin" Binding="{Binding Config.Plugin.Name, Mode=OneWay}" Width="160" />
                <DataGridTextColumn Header="Version" x:DataType="plugin:RTSharpPlugin" Binding="{Binding PluginVersion, Mode=OneWay}" Width="80" />
                <DataGridTextColumn Header="Author" x:DataType="plugin:RTSharpPlugin" Binding="{Binding Instance.Author, Mode=OneWay}" Width="120" />
                <DataGridTemplateColumn Header="Description" SortMemberPath="Instance.Description" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="plugin:RTSharpPlugin">
                            <TextBlock Text="{Binding Instance.Description}"
                                       ToolTip.Tip="{Binding Instance.Description}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="{DynamicResource DataGridCellTextBlockMargin}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Classes="DialogButtons" HorizontalAlignment="Left">
                <Button Command="{Binding PluginsSettingsClickCommand}">_Settings</Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Classes="DialogButtons">
                <Button Command="{Binding ManagePluginsClickCommand}">_Manage...</Button>
                <Button IsCancel="True" Click="EvClose">Close</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
