<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
        xmlns:vm="clr-namespace:RTSharp.ViewModels"
        xmlns:core="clr-namespace:RTSharp.Core"
        xmlns:local="clr-namespace:RTSharp.Views"
        mc:Ignorable="d"
        x:Class="RTSharp.Views.AddTorrentWindow"
		x:DataType="vm:AddTorrentViewModel"
        Title="RT# - Add torrent"
        Width="420"
        MinWidth="420"
        Height="400"
        MinHeight="400"
        MaxHeight="400"
        Name="window"
        Icon="/Assets/rtsharp.ico">
    <Design.DataContext>
        <vm:AddTorrentViewModel />
    </Design.DataContext>
    <Window.Styles>
        <StyleInclude Source="avares://RTSharp.Shared.Controls/Themes/GroupBox.axaml" />
    </Window.Styles>
    <TabControl>
        <TabItem>
            <TabItem.Header>
                <TextBlock>Source</TextBlock>
            </TabItem.Header>
            <StackPanel>
                <GroupBox Header="Data provider">
                    <views:DataProviderSelection DataProviders="{Binding DataProviders}" SelectedProvider="{Binding SelectedProvider}" />
                </GroupBox>
                <GroupBox Header="Remote directory">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="5,0,0,0" Command="{Binding BrowseRemoteDirectoryClickCommand}">Browse...</Button>
                        <TextBox Text="{Binding RemoteTargetPath}" />
                    </DockPanel>
                </GroupBox>
                <GroupBox>
                    <GroupBox.Header>
                        <RadioButton Classes="GroupBoxHeader" GroupName="main" IsChecked="{Binding FromFileSelected}">From file</RadioButton>
                    </GroupBox.Header>
                    <DockPanel>
                        <Button IsEnabled="{Binding FromFileSelected}"
                                Margin="5,0,0,0"
                                DockPanel.Dock="Right"
                                Command="{Binding BrowseLocalFileClickCommand}">Browse...</Button>
                        <TextBox IsEnabled="{Binding FromFileSelected}" Text="{Binding SelectedFileTextBox}" />
                    </DockPanel>
                </GroupBox>
                <GroupBox>
                    <GroupBox.Header>
                        <RadioButton Classes="GroupBoxHeader" GroupName="main" IsChecked="{Binding FromUriSelected}">From URI</RadioButton>
                    </GroupBox.Header>
                    <TextBox IsEnabled="{Binding FromUriSelected}" ClipToBounds="True" Text="{Binding Uri}" />
                </GroupBox>
                <GroupBox>
                    <GroupBox.Header>
                        <RadioButton Classes="GroupBoxHeader" GroupName="main" IsChecked="{Binding FromClipboardSelected}">From clipboard (URI's)</RadioButton>
                    </GroupBox.Header>
                    <Button IsEnabled="{Binding FromClipboardSelected}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding PreviewClipboardClickCommand}">Preview</Button>
                </GroupBox>
                <Grid ColumnDefinitions="*,Auto" Margin="0,15,0,15">
                    <StackPanel Grid.Column="0">
                        <CheckBox IsChecked="{Binding StartTorrent}" IsEnabled="{Binding !ForceStartTorrentOnAdd}">Start torrent</CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button HorizontalContentAlignment="Center" Width="73" Command="{Binding AddClickCommand}">Add</Button>
                        <Button HorizontalContentAlignment="Center" Width="73" Command="{Binding CancelClickCommand}">Cancel</Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </TabItem>
        <TabItem>
            <TabItem.Header>
                <TextBlock>Duplication</TextBlock>
            </TabItem.Header>
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <local:DuplicationTargetSelectorControl DataContext="{Binding DuplicationTargetSelector}" />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding AddDuplicationTargetClickCommand}">Add target</Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding DuplicationTargets}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:TorrentDuplication+DuplicationTarget">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding Provider.Host.Config.Plugin.Name}" />
                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding RemoteTargetPath}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding $parent[Window].((vm:AddTorrentViewModel)DataContext).RemoveDuplicationTargetClickCommand}"
                                        CommandParameter="{Binding}">Remove</Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
