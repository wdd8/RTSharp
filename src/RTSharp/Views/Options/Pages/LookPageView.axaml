<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:RTSharp.ViewModels.Options.Pages"
             xmlns:views="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
             x:Class="RTSharp.Views.Options.Pages.LookPageView"
             x:DataType="pages:LookPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="{StaticResource DialogMargin}" Spacing="{StaticResource GroupSpacing}">
        <GroupBox Header="Theme">
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource ControlSpacing}" RowSpacing="{StaticResource ControlSpacing}">
                <Label Grid.Column="0" Grid.Row="0" Target="{Binding #ThemeBox}">_Theme:</Label>
                <ComboBox Grid.Column="1" Grid.Row="0" Name="ThemeBox" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="150" />
                <Label Grid.Column="0" Grid.Row="1" Target="{Binding #ModeBox}">_Mode:</Label>
                <ComboBox Grid.Column="1" Grid.Row="1" Name="ModeBox" ItemsSource="{Binding ThemeVariants}" SelectedItem="{Binding ThemeVariant}" MinWidth="150" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Data providers">
            <CheckBox IsChecked="{Binding SpeedChartEnabled}">Show speed _chart</CheckBox>
        </GroupBox>

        <GroupBox Header="Torrent listing">
            <StackPanel Spacing="{StaticResource ControlSpacing}">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource ControlSpacing}">
                    <Label Grid.Column="0" Target="{Binding #RowHeightBox}">Row _height:</Label>
                    <NumericUpDown Grid.Column="1" Name="RowHeightBox" Value="{Binding RowHeight}" Minimum="8" Maximum="64" />
                    <TextBlock Grid.Column="2">px</TextBlock>
                </Grid>
                <CheckBox IsChecked="{Binding StateIcons}">Show state _icon next to torrent name</CheckBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Grids">
            <CheckBox IsChecked="{Binding AlternatingRowColors}">Alternate _row colors</CheckBox>
        </GroupBox>
    </StackPanel>
</UserControl>
