<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:RTSharp.ViewModels.Options.Pages"
             xmlns:views="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="380"
             x:Class="RTSharp.Views.Options.Pages.BehaviorPageView"
             x:DataType="pages:BehaviorPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="{StaticResource DialogMargin}" Spacing="{StaticResource GroupSpacing}">
        <GroupBox Header="Polling intervals">
            <StackPanel Spacing="{StaticResource ControlSpacing}">
                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource ControlSpacing}" RowSpacing="{StaticResource ControlSpacing}">
                    <Label Grid.Column="0" Grid.Row="0" Target="{Binding #FilesPollingBox}">_Files polling interval:</Label>
                    <NumericUpDown Grid.Column="1" Grid.Row="0" Name="FilesPollingBox" Value="{Binding FilesPollingIntervalSeconds}" Minimum="0.1" FormatString="F1" />
                    <TextBlock Grid.Column="2" Grid.Row="0">seconds</TextBlock>

                    <Label Grid.Column="0" Grid.Row="1" Target="{Binding #PeersPollingBox}">_Peers polling interval:</Label>
                    <NumericUpDown Grid.Column="1" Grid.Row="1" Name="PeersPollingBox" Value="{Binding PeersPollingIntervalSeconds}" Minimum="0.1" FormatString="F1" />
                    <TextBlock Grid.Column="2" Grid.Row="1">seconds</TextBlock>

                    <Label Grid.Column="0" Grid.Row="2" Target="{Binding #TrackersPollingBox}">_Trackers polling interval:</Label>
                    <NumericUpDown Grid.Column="1" Grid.Row="2" Name="TrackersPollingBox" Value="{Binding TrackersPollingIntervalSeconds}" Minimum="0.1" FormatString="F1" />
                    <TextBlock Grid.Column="2" Grid.Row="2">seconds</TextBlock>

                    <Label Grid.Column="0" Grid.Row="3" Target="{Binding #SearchDelayBox}">_Search-as-you-go delay:</Label>
                    <NumericUpDown Grid.Column="1" Grid.Row="3" Name="SearchDelayBox" Value="{Binding SearchAsYouGoDelaySeconds}" Minimum="0" FormatString="F1" />
                    <TextBlock Grid.Column="2" Grid.Row="3">seconds</TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                    <CheckBox IsChecked="{Binding PollActiveTabOnly}">P_oll selected torrent's active detail tab only</CheckBox>
                    <views:BuiltInIconImage Value="QUESTION" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                        ToolTip.Tip="When enabled, only the details tab currently in view (Files, Peers or Trackers) is polled for the selected torrent, instead of all of them at once." />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Torrents">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                <CheckBox IsChecked="{Binding AutoStartRecheckedTorrents}">Automatically sta_rt torrents after a recheck</CheckBox>
                <views:BuiltInIconImage Value="QUESTION" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                       ToolTip.Tip="When enabled, a torrent that finishes rechecking/hash-verifying and is fully complete will be started automatically." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Favicons">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}">
                <CheckBox IsChecked="{Binding UseFaviconGoogleAPI}">Use _Google favicon API</CheckBox>
                <views:BuiltInIconImage Value="QUESTION"
                       Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                       ToolTip.Tip="Fetching favicons via Google is more stable, but sends the domain you're looking up to Google." />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
