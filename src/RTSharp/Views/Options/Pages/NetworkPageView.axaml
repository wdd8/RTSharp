<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:RTSharp.ViewModels.Options.Pages"
             xmlns:views="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
             x:Class="RTSharp.Views.Options.Pages.NetworkPageView"
             x:DataType="pages:NetworkPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="0 0 0 7" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="{StaticResource DialogMargin}" Spacing="{StaticResource GroupSpacing}">
        <GroupBox Header="Proxy">
            <StackPanel Spacing="{StaticResource ControlSpacing}">
                <CheckBox IsChecked="{Binding ProxyEnabled}">_Use proxy</CheckBox>

                <!-- Rows are spaced by the text boxes' margin so the hidden validation row takes no space -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource ControlSpacing}" IsEnabled="{Binding ProxyEnabled}">
                    <Label Grid.Column="0" Grid.Row="0" VerticalAlignment="Top" Margin="0 4 0 0" Target="{Binding #AddressBox}">A_ddress:</Label>
                    <TextBox Grid.Column="1" Grid.Row="0"
                             Name="AddressBox"
                             Text="{Binding ProxyAddress}"
                             Watermark="socks5://127.0.0.1:1080"
                             ToolTip.Tip="Supported schemes: socks4, socks4a, socks5" />

                    <TextBlock Grid.Column="1" Grid.Row="1" Margin="0 0 0 7" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               IsVisible="{Binding !ProxyAddressValid}">Invalid proxy address</TextBlock>

                    <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Top" Margin="0 4 0 0" Target="{Binding #UsernameBox}">User_name:</Label>
                    <TextBox Grid.Column="1" Grid.Row="2" Name="UsernameBox" Text="{Binding ProxyUsername}" />

                    <Label Grid.Column="0" Grid.Row="3" VerticalAlignment="Top" Margin="0 4 0 0" Target="{Binding #PasswordBox}">Pass_word:</Label>
                    <TextBox Grid.Column="1" Grid.Row="3" Name="PasswordBox" Text="{Binding ProxyPassword}" PasswordChar="•"
                             ToolTip.Tip="Stored in plain text" />
                </Grid>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
