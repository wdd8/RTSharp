<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:options="clr-namespace:RTSharp.ViewModels.Options"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="490"
        Width="460" Height="490"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True"
        util:WindowPlacement.Page="{Binding CurrentPage}"
        x:Class="RTSharp.Views.Options.OptionsWindow"
        x:DataType="options:OptionsWindowViewModel"
        Title="RT# - Options">

    <Design.DataContext>
        <options:OptionsWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock,TextBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Panel > Grid">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Classes="DialogButtons" Margin="{StaticResource DialogMargin}">
            <Button IsDefault="True" Command="{Binding OkCommand}">OK</Button>
            <Button IsCancel="True" Command="{Binding CancelCommand}">Cancel</Button>
            <Button Command="{Binding ApplyCommand}">_Apply</Button>
        </StackPanel>

        <TabControl Margin="11,11,11,0" ItemsSource="{Binding Items, Mode=OneWay}" SelectedItem="{Binding CurrentlySelectedItem}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="options:OptionsItem">
                    <TextBlock Text="{Binding Text}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="options:OptionsItem">
                    <ScrollViewer>
                        <ContentControl Content="{Binding $parent[Window].((options:OptionsWindowViewModel)DataContext).SettingsContent}" />
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
