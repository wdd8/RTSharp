<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:RTSharp.ViewModels"
		xmlns:plugin="clr-namespace:RTSharp.Plugin"
		xmlns:sc="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
		xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="460"
        Width="760" Height="460"
        MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True"
        x:Class="RTSharp.ManagePluginsWindow"
		x:DataType="vm:ManagePluginsWindowViewModel"
        Title="RT# - Manage Plugins">

    <Window.Styles>
        <!-- Commands stacked between the lists, as wide as the widest -->
        <Style Selector="StackPanel.Commands > Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="*,Auto" ColumnSpacing="{StaticResource ControlSpacing}" RowSpacing="{StaticResource GroupSpacing}" Margin="{StaticResource DialogMargin}">
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Classes="DialogButtons">
            <Button IsCancel="True" Click="EvClose">Close</Button>
        </StackPanel>

        <GroupBox Grid.Column="0" Header="Available plugins">
            <ListBox ItemsSource="{Binding AvailablePlugins}" SelectedItem="{Binding SelectedAvailable}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="plugin:PluginManifest">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <sc:BuiltInIconImage Value="LINK_OK" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding IsDataProvider}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <StackPanel Grid.Column="1" Classes="Commands" Spacing="{StaticResource ControlSpacing}" VerticalAlignment="Center" MinWidth="75">
            <Button Command="{Binding ConfigureNewCommand}">_Add &gt;</Button>
            <Button Command="{Binding EditConfiguredCommand}">_Edit...</Button>
            <Button Command="{Binding DeleteConfiguredCommand}">&lt; _Remove</Button>
        </StackPanel>

        <GroupBox Grid.Column="2" Header="Configured plugins">
            <ListBox ItemsSource="{Binding ConfiguredPlugins}" SelectedItem="{Binding SelectedConfigured}"
                     DoubleTapped="EvDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="plugin:ConfiguredPlugin">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding InstanceName}" FontWeight="SemiBold" />
                                <sc:BuiltInIconImage Value="LINK_OK" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding Manifest.IsDataProvider}" />
                            </StackPanel>
                            <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Manifest.Name}" />
                            <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" IsVisible="{Binding Manifest.IsDataProvider}">
                                <Run Text="{Binding ServerId}" /><Run Text=" · " /><Run Text="{Binding DataProviderName}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
