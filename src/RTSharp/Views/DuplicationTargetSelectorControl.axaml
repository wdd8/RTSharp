<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
             xmlns:vm="using:RTSharp.ViewModels"
             mc:Ignorable="d"
             x:Class="RTSharp.Views.DuplicationTargetSelectorControl"
             x:DataType="vm:DuplicationTargetSelectorViewModel">
    <StackPanel>
        <GroupBox Header="Plugin">
            <views:DataProviderSelection DataProviders="{Binding DataProviders}" SelectedProvider="{Binding SelectedProvider}" HorizontalAlignment="Stretch" />
        </GroupBox>
        <GroupBox Header="Remote directory">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="5,0,0,0" Command="{Binding BrowseRemoteDirectoryClickCommand}">Browse...</Button>
                <TextBox Text="{Binding RemoteTargetPath}" IsEnabled="{Binding RemoteTargetPathEnabled}" />
            </DockPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
