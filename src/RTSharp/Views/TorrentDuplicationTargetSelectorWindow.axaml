<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:RTSharp.ViewModels"
		xmlns:local="using:RTSharp.Views"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d"
        Width="453"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True"
        x:Class="RTSharp.Views.TorrentDuplicationTargetSelectorWindow"
		x:DataType="vm:TorrentDuplicationTargetSelectorWindowViewModel"
        Title="RT# - Select Destination">

    <StackPanel Margin="{StaticResource DialogMargin}" Spacing="{StaticResource GroupSpacing}">
        <local:DuplicationTargetSelectorControl DataContext="{Binding Selector}" />
        <StackPanel Classes="DialogButtons">
            <Button IsDefault="True" Command="{Binding ConfirmClickCommand}">OK</Button>
            <Button IsCancel="True" Command="{Binding CancelClickCommand}">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
