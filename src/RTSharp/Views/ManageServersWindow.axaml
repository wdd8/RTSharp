<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:RTSharp.ViewModels"
        xmlns:models="using:RTSharp.Models"
        xmlns:sc="clr-namespace:RTSharp.Shared.Controls.Views;assembly=RTSharp.Shared.Controls"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="350"
        Width="460" Height="350"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True"
        x:Class="RTSharp.Views.ManageServersWindow"
        x:DataType="vm:ManageServersWindowViewModel"
        Icon="/Assets/rtsharp.ico"
        Title="RT# - Servers">

    <Window.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,3,4,4" />
        </Style>
        <!-- Commands stacked along the right, as wide as the widest -->
        <Style Selector="StackPanel.Commands > Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GroupSpacing}" Margin="{StaticResource DialogMargin}">
        <ListBox Grid.Column="0" ItemsSource="{Binding ConfiguredServers}" SelectedItem="{Binding SelectedServer}" DoubleTapped="EvDoubleTapped">
            <ListBox.ItemTemplate>
                <!-- Tile: the server icon tells servers apart from the other lists at a glance -->
                <DataTemplate x:DataType="models:Server">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource ControlSpacing}">
                        <sc:BuiltInIconImage Grid.Column="0" Value="SERVER" Width="32" Height="32" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ServerId}" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="{Binding Host}" /><Run Text=":" /><Run Text="{Binding Port}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConnectionStatus}"
                                       IsVisible="{Binding ConnectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <Run Text="{Binding ConnectionStatus}" /><Run Text=" " /><Run Text="{Binding Latency}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Modeless: changes take effect at once, so the window only needs Close -->
        <DockPanel Grid.Column="1" MinWidth="75">
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsCancel="True" Click="EvClose">Close</Button>
            <StackPanel Classes="Commands" Spacing="{StaticResource ControlSpacing}">
                <Button Command="{Binding AddCommand}">_Add...</Button>
                <Button Command="{Binding EditCommand}">_Edit...</Button>
                <Button Command="{Binding DeleteCommand}">_Delete</Button>
                <Separator Margin="0,4" />
                <Button Command="{Binding TestConnectionCommand}">Test _Connection</Button>
                <Button Command="{Binding BrowseFileSystemCommand}">_Browse File System</Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
