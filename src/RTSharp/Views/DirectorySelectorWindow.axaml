<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RTSharp.ViewModels;assembly=RTSharp"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:converters="clr-namespace:RTSharp.ViewModels.Converters"
        xmlns:sharedConverters="using:RTSharp.Shared.Controls.Converters"
        xmlns:models="clr-namespace:RTSharp.Models"
        d:DataContext="{x:Static vm:ExampleDirectorySelectorWindowViewModel.ViewModel}"
        x:DataType="vm:DirectorySelectorWindowViewModel"
        mc:Ignorable="d"
        MinWidth="450"
        MinHeight="200"
        Width="760"
        Height="480"
        x:Class="RTSharp.Views.DirectorySelectorWindow"
        Icon="/Assets/rtsharp.ico"
        Title="{Binding WindowTitle}">

    <Control.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PermissionTypeBrush" Color="#4A6C94" />
                    <SolidColorBrush x:Key="PermissionNoneBrush" Color="#A0A7AF" />
                    <SolidColorBrush x:Key="LinkTargetBrush" Color="#6B7480" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PermissionTypeBrush" Color="#7E9DC2" />
                    <SolidColorBrush x:Key="PermissionNoneBrush" Color="#5C636B" />
                    <SolidColorBrush x:Key="LinkTargetBrush" Color="#8F98A3" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <converters:SIDataSizeConverter x:Key="SIDataSizeConverter"/>
            <sharedConverters:ToHexStringConverter x:Key="ToHexStringConverter" />
        </ResourceDictionary>
    </Control.Resources>

    <Window.Styles>
        <Style Selector="StackPanel.Permissions > TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
        </Style>
        <Style Selector="StackPanel.Permissions Run[Text=d], StackPanel.Permissions Run[Text=l]">
            <Setter Property="Foreground" Value="{DynamicResource PermissionTypeBrush}" />
        </Style>
        <Style Selector="StackPanel.Permissions Run[Text=-]">
            <Setter Property="Foreground" Value="{DynamicResource PermissionNoneBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*,Auto" Margin="8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" RowDefinitions="*">
            <TextBox Name="PathTextBox" Text="{Binding Selected.Path, Mode=OneWay}" Grid.Column="0" Margin="0 0 8 0" />
            <Button Grid.Column="1" Margin="0 0 4 0" Command="{Binding RefreshCommand}" HotKey="F5" ToolTip.Tip="Refresh" i:Attached.Icon="fa7-solid fa7-rotate-right" />
            <Button Grid.Column="2" Command="{Binding SetCurrentFolderCommand}" CommandParameter="{Binding #PathTextBox.Text}" IsDefault="True" i:Attached.Icon="fa7-solid fa7-right-long" />
        </Grid>

        <DataGrid
            Name="MainGrid"
            Grid.Row="1"
            Margin="0 8 0 8"
            BorderBrush="Gray"
            BorderThickness="1"
            AutoGenerateColumns="False"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            GridLinesVisibility="Horizontal"
            SelectionMode="Extended"
            ItemsSource="{Binding Items}"
            DoubleTapped="EvDoubleTapped"
            SelectionChanged="EvSelectionChanged"
        >

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Media_info"
                              Command="{Binding MediaInfoCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                    />
                    <MenuItem Header="Preview with _mpv"
                              Command="{Binding PreviewCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                              IsEnabled="{Binding PreviewAllowed}"
                    />
                    <Separator />
                    <MenuItem Header="Remove directory"
                              Command="{Binding RemoveEmptyDirectoryCommand}"
                              CommandParameter="{Binding #MainGrid.SelectedItems}"
                              IsEnabled="{Binding RemoveDirectoryAllowed}"
                    />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" IsReadOnly="True" Width="340">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:FileSystemItem">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="{DynamicResource DataGridCellTextBlockMargin}">
                                <Image Source="{Binding Display.Icon^}"
                                       IsVisible="{Binding Display.Icon^, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Width="16" Height="16"
                                       VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Display.Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LinkTarget, StringFormat='→ {0}'}"
                                           IsVisible="{Binding LinkTarget, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="{DynamicResource LinkTargetBrush}"
                                           ToolTip.Tip="Symbolic link"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate x:DataType="models:FileSystemItem">
                            <TextBox Text="{Binding Display.Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Permissions" IsReadOnly="True" SortMemberPath="Permissions" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:FileSystemItem">
                            <StackPanel Classes="Permissions"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="{DynamicResource DataGridCellTextBlockMargin}"
                                        Background="Transparent"
                                        IsVisible="{Binding PermissionBits, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ToolTip.Tip>
                                    <TextBlock>
                                        <Run Text="Owner: " /><Run Text="{Binding Owner}" FontWeight="SemiBold" />
                                        <LineBreak />
                                        <Run Text="Group: " /><Run Text="{Binding Group}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </ToolTip.Tip>
                                <TextBlock><Run Text="{Binding PermissionBits[0]}" /></TextBlock>
                                <TextBlock ToolTip.Tip="{Binding Owner, StringFormat='Owner: {0}'}"><Run Text="{Binding PermissionBits[1]}" /><Run Text="{Binding PermissionBits[2]}" /><Run Text="{Binding PermissionBits[3]}" /></TextBlock>
                                <TextBlock ToolTip.Tip="{Binding Group, StringFormat='Group: {0}'}"><Run Text="{Binding PermissionBits[4]}" /><Run Text="{Binding PermissionBits[5]}" /><Run Text="{Binding PermissionBits[6]}" /></TextBlock>
                                <TextBlock ToolTip.Tip="Others"><Run Text="{Binding PermissionBits[7]}" /><Run Text="{Binding PermissionBits[8]}" /><Run Text="{Binding PermissionBits[9]}" /></TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" IsReadOnly="True" Binding="{Binding Size, Mode=OneWay, Converter={StaticResource SIDataSizeConverter}, TargetNullValue=''}" Width="100" />
                <DataGridTextColumn Header="Last modified" IsReadOnly="True" Binding="{Binding LastModified, Mode=OneWay}" Width="170" />
                <DataGridTemplateColumn Header="Torrents" IsReadOnly="True" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:FileSystemItem">
                            <ItemsControl ItemsSource="{Binding Torrents}" VerticalAlignment="Center" Margin="{DynamicResource DataGridCellTextBlockMargin}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Torrent">
                                        <TextBlock ToolTip.Tip="{Binding Hash, Converter={StaticResource ToHexStringConverter}}">
                                            <Run Text="{Binding Name}" /><Run Text=" (" /><Run Text="{Binding DataOwner.Config.Plugin.Name}" /><Run Text=")" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Grid Grid.Column="0">
                <Button
                    Command="{Binding CreateDirectoryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="fa7-solid fa7-folder-plus" Margin="0 0 4 0" />
                        <TextBlock>Create directory</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsBrowser}">
                    <Button Margin="0 0 4 0" Command="{Binding SelectCommand}">Select</Button>
                    <Button Command="{Binding CancelCommand}">Cancel</Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
