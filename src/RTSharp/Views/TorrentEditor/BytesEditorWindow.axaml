<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hex="clr-namespace:AvaloniaHex;assembly=AvaloniaHex"
        xmlns:rendering="clr-namespace:AvaloniaHex.Rendering;assembly=AvaloniaHex"
        xmlns:vm="using:RTSharp.ViewModels.TorrentEditor"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        Width="760" Height="520"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        x:Class="RTSharp.Views.TorrentEditor.BytesEditorWindow"
        x:DataType="vm:BytesEditorWindowViewModel"
        Title="RT# - Edit bytes">

    <Grid RowDefinitions="*,Auto" Margin="8">
        <hex:HexEditor Grid.Row="0"
                       Document="{Binding Document}"
                       FontFamily="Cascadia Code,JetBrains Mono,Monospace,monospace">
            <hex:HexEditor.Columns>
                <rendering:OffsetColumn />
                <rendering:HexColumn />
                <rendering:AsciiColumn />
            </hex:HexEditor.Columns>
        </hex:HexEditor>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0 8 0 0">
            <Button Grid.Column="0" Margin="0 0 4 0" Command="{Binding ImportClickCommand}">Import file...</Button>
            <Button Grid.Column="1" Command="{Binding ExportClickCommand}">Export file...</Button>
            <TextBlock Grid.Column="2" Margin="8 0" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="{Binding Length, StringFormat='{}{0} bytes'}" />
            <Button Grid.Column="3" Margin="0 0 4 0" Command="{Binding OkClickCommand}">OK</Button>
            <Button Grid.Column="4" Command="{Binding CancelClickCommand}">Cancel</Button>
        </Grid>
    </Grid>
</Window>
