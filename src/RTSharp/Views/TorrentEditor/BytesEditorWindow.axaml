<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hex="clr-namespace:AvaloniaHex;assembly=AvaloniaHex"
        xmlns:rendering="clr-namespace:AvaloniaHex.Rendering;assembly=AvaloniaHex"
        xmlns:vm="using:RTSharp.ViewModels.TorrentEditor"
        xmlns:util="using:RTSharp.Views.Util"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
        Width="760" Height="520"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        util:WindowPlacement.Remember="True"
        x:Class="RTSharp.Views.TorrentEditor.BytesEditorWindow"
        x:DataType="vm:BytesEditorWindowViewModel"
        Title="RT# - Edit Bytes">

    <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource GroupSpacing}" Margin="{StaticResource DialogMargin}">
        <hex:HexEditor Grid.Row="0"
                       Document="{Binding Document}"
                       FontFamily="Cascadia Code,JetBrains Mono,Monospace,monospace">
            <hex:HexEditor.Columns>
                <rendering:OffsetColumn />
                <rendering:HexColumn />
                <rendering:AsciiColumn />
            </hex:HexEditor.Columns>
        </hex:HexEditor>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Classes="DialogButtons" HorizontalAlignment="Left">
                <Button Command="{Binding ImportClickCommand}">_Import File...</Button>
                <Button Command="{Binding ExportClickCommand}">_Export File...</Button>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="{Binding Length, StringFormat='{}{0} bytes'}" />
            <StackPanel Grid.Column="2" Classes="DialogButtons">
                <Button IsDefault="True" Command="{Binding OkClickCommand}">OK</Button>
                <Button IsCancel="True" Command="{Binding CancelClickCommand}">Cancel</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
