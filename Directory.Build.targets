<Project>
  <!--
    Consolidate SkiaSharp dep, probably won't need it after everyone transitions to v4
  -->
  <Target Name="CheckSkiaPackageVersions"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(DesignTimeBuild)' != 'true' And !$(MSBuildProjectDirectory.Contains('ProDataGrid'))">
    <ItemGroup>
      <_CheckedPackageAsset Include="@(ResolvedCompileFileDefinitions);@(RuntimeCopyLocalItems);@(RuntimeTargetsCopyLocalItems);@(NativeCopyLocalItems)" />
      <_MisalignedSkiaPackage Include="%(_CheckedPackageAsset.NuGetPackageId) %(_CheckedPackageAsset.NuGetPackageVersion)"
                              Condition="$([System.String]::Copy('%(_CheckedPackageAsset.NuGetPackageId)').StartsWith('SkiaSharp')) And '%(_CheckedPackageAsset.NuGetPackageVersion)' != '$(SkiaSharpVersion)'" />
      <_HarfBuzzPackage Include="%(_CheckedPackageAsset.NuGetPackageId) %(_CheckedPackageAsset.NuGetPackageVersion)"
                        Condition="$([System.String]::Copy('%(_CheckedPackageAsset.NuGetPackageId)').StartsWith('HarfBuzzSharp'))" />
      <_HarfBuzzVersion Include="%(_CheckedPackageAsset.NuGetPackageVersion)"
                        Condition="$([System.String]::Copy('%(_CheckedPackageAsset.NuGetPackageId)').StartsWith('HarfBuzzSharp'))" />
    </ItemGroup>
    <PropertyGroup>
      <_HarfBuzzVersionCount>@(_HarfBuzzVersion->Distinct()->Count())</_HarfBuzzVersionCount>
    </PropertyGroup>
    <Error Condition="'@(_MisalignedSkiaPackage)' != ''"
           Text="SkiaSharp packages must resolve to $(SkiaSharpVersion), but found: @(_MisalignedSkiaPackage->Distinct(), ', ')" />
    <Error Condition="'$(_HarfBuzzVersionCount)' &gt; '1'"
           Text="HarfBuzzSharp packages must all resolve to one version, but found: @(_HarfBuzzPackage->Distinct(), ', ')" />
  </Target>

  <PropertyGroup>
    <AvaloniaXamlCompiledMarker>$(IntermediateOutputPath)Avalonia\xaml-compiled</AvaloniaXamlCompiledMarker>
  </PropertyGroup>

  <Target Name="InvalidateAvaloniaXamlCompiledMarker" BeforeTargets="CompileAvaloniaXaml">
    <Delete Files="$(AvaloniaXamlCompiledMarker)" />
  </Target>

  <Target Name="WriteAvaloniaXamlCompiledMarker" AfterTargets="CompileAvaloniaXaml">
    <Touch Files="$(AvaloniaXamlCompiledMarker)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(AvaloniaXamlCompiledMarker)" />
    </ItemGroup>
  </Target>

  <!--
    ReadyToRun images are kept in obj whether they're composite or not, and a publish in the other mode reuses them.
    Composite components shipped without their composite image make the app fail fast on start
  -->
  <PropertyGroup>
    <ReadyToRunModeMarker>$(IntermediateOutputPath)R2R\composite-$(PublishReadyToRunComposite)</ReadyToRunModeMarker>
  </PropertyGroup>

  <Target Name="InvalidateReadyToRunOnModeChange"
          BeforeTargets="_PrepareForReadyToRunCompilation"
          Condition="!Exists('$(ReadyToRunModeMarker)')">
    <RemoveDir Directories="$(IntermediateOutputPath)R2R" />
    <MakeDir Directories="$(IntermediateOutputPath)R2R" />
    <Touch Files="$(ReadyToRunModeMarker)" AlwaysCreate="true" />
  </Target>

  <Target Name="RecompileWithoutCompiledAvaloniaXaml"
          BeforeTargets="CoreCompile"
          Condition="'@(AvaloniaResource)@(AvaloniaXaml)' != '' And '$(DesignTimeBuild)' != 'true' And '$(EnableAvaloniaXamlCompilation)' != 'false' And !Exists('$(AvaloniaXamlCompiledMarker)')">
    <Delete Files="@(IntermediateAssembly)" />
  </Target>
</Project>
